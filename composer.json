{
    "name": "kinetis/pingpong",
    "description": "A runnable ping-pong demo application showcasing Kinetis: MySQL, migrations, mapped entities and a request-scoped unit of work over kinetis/orm, Redis-backed cache and queue, events, a cron-driven command, and real-time updates over kinetis/broadcasting, including a private channel.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "^1.22.1",
        "kinetis/migrations": "^1.4.0",
        "kinetis/persistence": "^1.4.3",
        "kinetis/database-bridge": "^1.4.0",
        "kinetis/orm": "^1.12.0",
        "kinetis/redis": "^1.0.1",
        "kinetis/cache-redis": "^1.3.0",
        "kinetis/queue": "^1.7.0",
        "kinetis/mcp": "^1.8.0",
        "kinetis/mcp-protocol": "^1.1.0",
        "kinetis/queue-redis": "^1.8.1",
        "kinetis/broadcasting": "^1.6.0",
        "kinetis/revolt-http-client": "^1.4.1",
        "kinetis/views": "^1.0.0",
        "kinetis/views-php": "^1.0.0",
        "monolog/monolog": "^3.10.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "kinetis/query-builder": "^1.8.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.3",
        "vimeo/psalm": "^6.17"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
