{
    "name": "kinetis/pingpong",
    "description": "A runnable ping-pong demo application showcasing Kinetis: MySQL, migrations, the query builder, Redis-backed cache and queue, events, a cron-driven command, and real-time updates over Soketi.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "^1.28.3",
        "kinetis/migrations": "^1.3.6",
        "kinetis/persistence": "^1.11.5",
        "kinetis/cache-redis": "^1.2.1",
        "kinetis/query-builder": "^1.4.2",
        "kinetis/queue": "^1.7.0",
        "kinetis/mcp": "^1.1.0",
        "kinetis/queue-redis": "^1.0.0",
        "league/plates": "^3.6.0",
        "monolog/monolog": "^3.10.0",
        "psr/http-message": "^2.0",
        "pusher/pusher-php-server": "^7.3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
